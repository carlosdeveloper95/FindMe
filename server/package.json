{
  "name": "@findme/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:better-sqlite3 --external:express --external:socket.io",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@findme/shared": "*",
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "*",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "vitest": "^5.0.0"
  }
}
